# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# URL of your deployed frontend (used for CORS)
# In production: https://your-client.vercel.app
# In local dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Only used for local development (Vercel ignores this)
PORT=5000

# Runtime environment
NODE_ENV=development

# SMTP — Email (feedback)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here
MAIL_TO=inbox_to_receive_feedback@gmail.com
